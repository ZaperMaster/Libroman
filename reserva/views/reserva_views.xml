<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="reserva_view_form" model="ir.ui.view">
        <field name="name">reserva.form</field>
        <field name="model">reserva</field>
        <field name="arch" type="xml">
            <form string="Reserva">
                <sheet>
                    <group>
                        <field name="persona"/>
                        <field name="telefono" widget="phone"/>
                        <field name="libro_id"/>
                    </group>
                    <group>
                        <field name="fecha_reserva"/>
                        <field name="fecha_devolucion"/>
                        <field name="duracion" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="reserva_view_list" model="ir.ui.view">
        <field name="name">reserva.list</field>
        <field name="model">reserva</field>
        <field name="arch" type="xml">
            <list>
                <field name="persona"/>
                <field name="telefono"/>
                <field name="libro_id"/>
                <field name="fecha_reserva"/>
                <field name="fecha_devolucion"/>
                <field name="duracion"/>
            </list>
        </field>
    </record>

    <record id="action_reserva" model="ir.actions.act_window">
        <field name="name">Reserva</field>
        <field name="res_model">reserva</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
